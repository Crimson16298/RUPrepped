# Copy to .env locally. Never commit the filled file.
DATABASE_URL=postgresql://ruprepped:LOCAL_PASSWORD@127.0.0.1:5432/ruprepped
# Require both settings before a write command can run.
TELEMETRY_DATABASE_ENV=development
# Local demo database: allowed only for localhost / 127.0.0.1 / ::1.
DATABASE_SSL=local
# For a remote Tiger Data/PostgreSQL database instead, use DATABASE_SSL=require-verify.
# Optional: package-relative or absolute path to a PEM CA bundle trusted for this
# approved development endpoint. Do not commit the certificate if it is private.
# DATABASE_CA_CERT_PATH=certs/approved-development-ca.pem
