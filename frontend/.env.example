# Select `mock` for the local demo or `backend` to call FastAPI.
VITE_INTERVIEW_MODE=mock
# Used only when VITE_INTERVIEW_MODE=backend.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Provider-backed answer evaluation can take longer than session creation.
VITE_API_TIMEOUT_MS=30000
VITE_API_ANSWER_TIMEOUT_MS=60000

# Optional local Presage companion. Keep disabled until the Presage SDK key has
# been rotated and the owner has approved a fresh local-demo capability token.
# This browser-visible token is only for the loopback companion; never use an
# SDK key here or commit a real value to this file.
VITE_PRESAGE_COMPANION_ENABLED=false
VITE_PRESAGE_COMPANION_BASE_URL=http://127.0.0.1:8765
VITE_PRESAGE_COMPANION_TOKEN=
