# Default deterministic mode; use "gemini" only with a server-side key.
INTERVIEW_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=10000

# Server-only ElevenLabs settings for question audio and answer transcription.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

BACKEND_URL=http://localhost:8000
